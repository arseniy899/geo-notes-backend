# Copy to .env (never commit it). Used by docker-compose.yml.
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=geonotes
POSTGRES_USER=geonotes
POSTGRES_PASSWORD=change-me-long-random

# firebase | dev   (dev accepts "Bearer dev:<uid>" — NEVER in production)
AUTH_MODE=firebase

# Google Play billing (see README → "Google Play billing setup").
# Put the Play service-account key at ./secrets/play-service-account.json (never commit it).
# To reuse the Firebase service account instead, point this at /run/secrets/firebase-service-account.json.
PLAY_PACKAGE_NAME=com.ars899.geonotes
PLAY_SERVICE_ACCOUNT_JSON=/run/secrets/play-service-account.json
PLAY_ALLOW_TEST_PURCHASES=true

# Real-time developer notifications (Pub/Sub push → https://$API_DOMAIN/v1/play/rtdn). Leave empty to disable (401).
RTDN_AUDIENCE=https://api.example.com/v1/play/rtdn
RTDN_PUSH_SERVICE_ACCOUNT=play-rtdn-push@your-project.iam.gserviceaccount.com

# Optional overrides
RATE_LIMIT_EVENTS_PER_MINUTE=60
RATE_LIMIT_INVITES_PER_MINUTE=10
