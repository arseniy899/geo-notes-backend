# Copy to .env (never commit it). Used by docker-compose.yml.
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=geonotes
POSTGRES_USER=geonotes
POSTGRES_PASSWORD=change-me-long-random

# firebase | dev   (dev accepts "Bearer dev:<uid>" — NEVER in production)
AUTH_MODE=firebase

# Optional overrides
RATE_LIMIT_EVENTS_PER_MINUTE=60
RATE_LIMIT_INVITES_PER_MINUTE=10
